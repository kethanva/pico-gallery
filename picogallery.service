[Unit]
Description=PicoGallery photo slideshow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=video
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=RUST_LOG=info
RuntimeDirectory=picogallery
Environment=XDG_RUNTIME_DIR=/run/picogallery
ExecStart=/usr/bin/picogallery
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
UMask=0077
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
TasksMax=128
MemoryMax=384M
ReadWritePaths=-/etc/wpa_supplicant -/etc/NetworkManager/system-connections -/media

# Allow DRM/input access without root. Wi-Fi and USB mounting require host
# policy (NetworkManager/udisks) and are deliberately not granted privileges.
SupplementaryGroups=video render input

[Install]
WantedBy=multi-user.target
