# Copy to deploy.local.env and fill in real values.
# deploy.local.env is gitignored — never commit it.
# On the Pi: chmod 600 deploy.local.env && chown root:root deploy.local.env
# (deploy.sh refuses group/world-writable files; root runs require root ownership).
#
#   cp deploy.local.env.example deploy.local.env
#
# Then either:
#   sudo bash deploy.sh
# or override per-run:
#   sudo PHOTOPRISM_PASS='…' PICOGALLERY_VERSION=v0.1.3-kva.1 bash deploy.sh

# Required for PhotoPrism provisioning
PHOTOPRISM_URL=http://photoprism.local:2342
PHOTOPRISM_USER=admin
PHOTOPRISM_PASS=CHANGE-ME

# Optional overrides (deploy.sh also accepts these from the environment)
# REPO_SLUG=kethanva/pico-gallery
# BRANCH=kva-revamparchitecture
# KIOSK_USER=picokiosk
# PICOGALLERY_VERSION=v0.1.3-kva.1
